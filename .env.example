# ==============================================================================
# PlateWise 2.0 Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file and rename it to `.env`
# 2. Fill in the values below with your own API keys
# 3. NEVER commit your actual `.env` file to version control.
# ==============================================================================

# ── Supabase (Database & Authentication) ──
# Get these from your Supabase Project Settings -> API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres"

# ── Large Language Models (LLMs) ──
# Google Gemini (Primary Fallback and Fast Inference)
GEMINI_API_KEY="your-gemini-api-key"
# Optional: Set a specific Gemini model if you don't want the default flash-lite
# GEMINI_MODEL="gemini-3.1-flash-lite"

# Groq (Blazing Fast Open Source Inference: Llama 3, Mixtral)
# Get a free key at https://console.groq.com
GROQ_API_KEY="your-groq-api-key"

# OpenAI & Anthropic (Upcoming Support)
# OPENAI_API_KEY=""
# ANTHROPIC_API_KEY=""
