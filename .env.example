# PlateWise — Environment Variables
# Copy this file to scripts/.env and fill in real values.
# NEVER commit scripts/.env to git.

# ─── LLM ──────────────────────────────────────────────────────────────────────
# Gemini API key — get one at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Primary Gemini model (fallback cascade handles quota errors automatically)
GEMINI_MODEL=gemini-3.1-flash-lite

# ─── Auth ─────────────────────────────────────────────────────────────────────
# API key for PlateWise backend — any strong random string
# Example: openssl rand -hex 32
PLATEWISE_API_KEY=your_secret_api_key_here

# ─── Runtime ──────────────────────────────────────────────────────────────────
# Set to "true" when deployed on Render (switches to /tmp paths)
RENDER=
